{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetroDrive vehicle profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "manufacturer", "model", "generation", "year_range", "engine", "transmission_variants", "verification_status", "physical_interface", "vehicle_connector", "diagnostic_pins", "protocol", "initialization", "supported_parameters", "warning_configuration", "dashboard_capabilities", "display_theme", "media_theme", "boot_theme", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "profile_version": {"const": "0.1.0"},
    "manufacturer": {"type": "string"}, "model": {"type": "string"}, "generation": {"type": ["string", "null"]},
    "year_range": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
    "engine": {"type": ["string", "null"]}, "transmission_variants": {"type": "array", "items": {"type": "string"}},
    "verification_status": {"enum": ["unverified", "bench_verified", "vehicle_verified"]},
    "physical_interface": {"enum": ["can", "kline", "unresolved"]},
    "vehicle_connector": {"type": ["string", "null"]},
    "diagnostic_pins": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 16}},
    "protocol": {"type": "string"}, "initialization": {"type": "object"},
    "supported_parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "warning_configuration": {"type": "object"}, "dashboard_capabilities": {"type": "array", "items": {"type": "string"}},
    "display_theme": {"type": "string"}, "media_theme": {"type": "string"}, "boot_theme": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"parameter": {
    "type": "object", "additionalProperties": false,
    "required": ["name", "standard", "source", "verification_status", "raw_message", "conversion", "units", "observed_range", "last_verified_vehicle"],
    "properties": {
      "name": {"type": "string"}, "standard": {"type": "boolean"}, "source": {"type": "string", "minLength": 1},
      "verification_status": {"enum": ["unverified", "bench_verified", "vehicle_verified"]},
      "raw_message": {"type": "string"}, "conversion": {"type": "string"}, "units": {"type": "string"},
      "observed_range": {"type": ["array", "null"]}, "last_verified_vehicle": {"type": ["string", "null"]}
    }
  }}
}
